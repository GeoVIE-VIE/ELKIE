# {{ ansible_managed }}
# ES Ingest Proxy -- allows POST/PUT only, blocks _search/_cat/_cluster
# Honeypot subnet ships to port {{ ingest_proxy_port }}, NOT 9200

server {
    listen {{ ingest_proxy_port }};

    location / {
        # Allow Filebeat health check
        if ($request_method = GET) {
            # Only allow GET on root path for health check
            set $block "yes";
        }
        if ($request_uri = "/") {
            set $block "no";
        }

        # Block read operations
        if ($request_uri ~* "(_search|_cat|_cluster|_nodes|_tasks|_snapshot)") {
            return 403;
        }

        # Block GET on anything except root
        if ($block = "yes") {
            return 403;
        }

        # Allow POST and PUT (ingest operations)
        proxy_pass http://127.0.0.1:9200;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 90;
    }
}
