# {{ ansible_managed }}
[default]
aws_access_key_id = AKIA{{ '%016x' | format(range(0, 2**64) | random) | upper }}
aws_secret_access_key = {{ '%040x' | format(range(0, 2**160) | random) }}
region = us-east-1

[production]
aws_access_key_id = AKIA{{ '%016x' | format(range(0, 2**64) | random) | upper }}
aws_secret_access_key = {{ '%040x' | format(range(0, 2**160) | random) }}
region = us-east-2
