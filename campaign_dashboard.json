        "datasource": { "type": "elasticsearch", "uid": "bfhfgdmjeb6kgd" },
        "targets": [{
          "refId": "A",
          "metrics": [{ "type": "count", "id": "1" }],
          "bucketAggs": [],
          "query": "*",
          "timeField": "indexed_at"
        }],
        "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto" },
        "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } }
