# ============================================================================
# ELKIE SOC — Environment Configuration
# ============================================================================
# Copy to .env and fill in your values:
#   cp .env.example .env && chmod 600 .env
#
# Then source before running any ELKIE component:
#   source .env
# ============================================================================

# ── Network Layout ──────────────────────────────────────────────────────────
# Adjust these to match your VLAN/subnet structure.
# HONEYPOT_SUBNET should be ISOLATED from your production network.

ELK_IP="192.168.50.3"                    # ELK stack host (ES, Kibana, Grafana, MISP, Authelia)
HONEYPOT_SUBNET="192.168.40.0/24"        # Isolated honeypot VLAN
TPOT_IP="192.168.40.3"                   # T-Pot honeypot suite + jump host
SACRIFICIAL_IP="192.168.40.99"           # SSH honeypot with PAM auth
REMNUX_IP="192.168.40.5"                 # REMnux static malware analysis
SANDBOX_IP="192.168.40.6"               # Dynamic analysis / detonation VM
KALI_IP="192.168.2.160"                  # Kali recon (optional)
PROXMOX_IP="192.168.99.160"             # Proxmox VE host

# ── SSH Access ──────────────────────────────────────────────────────────────
# T-Pot is the JUMP HOST for all honeypot subnet access.
# NEVER SSH directly from ELK to 192.168.40.x.

TPOT_SSH_PORT="64295"                    # T-Pot non-standard SSH port
TPOT_SSH_USER="lepots"                   # T-Pot SSH username
TPOT_SSH_PASS=""                         # T-Pot SSH password (key auth preferred)

REMNUX_SSH_USER="nalyzer"                # REMnux SSH username
REMNUX_SSH_PASS=""                       # REMnux SSH password
REMNUX_SSH_PORT="22"

SANDBOX_SSH_USER="dettony"               # Sandbox SSH username
SANDBOX_SSH_PORT="22"

SACRIFICIAL_SSH_USER="root"              # Sacrificial VM SSH user
SACRIFICIAL_SSH_PORT="22"

# ── Proxmox API ─────────────────────────────────────────────────────────────
# Used for auto-starting REMnux, snapshot management, VM control.

PROXMOX_API_URL="https://${PROXMOX_IP}:8006"
PROXMOX_NODE="flexiserve"                # Proxmox node name
PVE_TOKEN_ID=""                          # e.g. root@pam!ApiKeyForElkie
PVE_API_TOKEN=""                         # e.g. PVEAPIToken=root@pam!ApiKeyForElkie=<uuid>

# VM IDs in Proxmox
VMID_REMNUX="106"
VMID_SACRIFICIAL="107"
VMID_SANDBOX="109"
SANDBOX_SNAPSHOT="clean"                 # Clean snapshot name for restore

# ── Elasticsearch ───────────────────────────────────────────────────────────

ES_URL="http://localhost:9200"           # ES endpoint (localhost if on ELK host)
ES_FILEBEAT_INDEX=".ds-filebeat-*"       # Filebeat data stream pattern
ES_RESULT_INDEX="malware-analysis"       # Where analysis results are indexed

# ── Grafana ─────────────────────────────────────────────────────────────────

GRAFANA_URL="https://${ELK_IP}:3000"
GRAFANA_TOKEN=""                         # Grafana API token for dashboard management
GRAFANA_DASHBOARD_UID="tpot-attack-overview"
GRAFANA_DS_FILEBEAT_UID=""               # Filebeat datasource UID in Grafana
GRAFANA_DS_MALWARE_UID=""                # Malware-analysis datasource UID in Grafana

# ── MISP ────────────────────────────────────────────────────────────────────

MISP_URL="https://localhost"
MISP_API_KEY=""

# ── API Keys ────────────────────────────────────────────────────────────────

CLAUDE_API_KEY=""                         # Anthropic Claude API key for LLM analysis
VT_API_KEY=""                             # VirusTotal API key
MB_API_KEY=""                             # MalwareBazaar API key
ABUSEIPDB_API_KEY=""                      # AbuseIPDB reporting key
DISCORD_WEBHOOK_URL=""                    # Discord webhook for alerts
SHODAN_API_KEY=""                         # Shodan API key (for Kali recon, optional)

# ── LLM Configuration ──────────────────────────────────────────────────────
# Controls how the LLM is used in the analysis pipeline.
#   "api"   — Use Claude API (requires CLAUDE_API_KEY)
#   "local" — Use local Ollama endpoint (no API key needed)
#   "none"  — Skip LLM analysis, rely on YARA/capa/VT only

LLM_MODE="api"                           # api | local | none
LLM_API_MODEL="claude-sonnet-4-20250514" # Model for API mode
LLM_LOCAL_URL="http://localhost:11434"   # Ollama endpoint for local mode
LLM_LOCAL_MODEL="llama3:8b"              # Model name for local mode

# ── Cover Story ─────────────────────────────────────────────────────────────
# Fake company identity for the sacrificial VM honeypot.
# Attackers see these when they connect.

COVER_COMPANY="Dirigo Systems LLC"
COVER_DOMAIN="dirigosystems.net"
COVER_HOSTNAME="ds-prod-web01"
COVER_CITY="Auburn"
COVER_STATE="Maine"
COVER_COUNTRY="US"
COVER_SSL_CN="portal.${COVER_DOMAIN}"
COVER_SSL_ORG="${COVER_COMPANY}"

# ── Sacrificial VM Agent Names ──────────────────────────────────────────────
# These are the hostnames that appear in Elasticsearch auditd/filebeat logs.
# Must match what the sacrificial VM reports.

SACRIFICIAL_AGENT_NAME="ds-prod-web01"
SACRIFICIAL_AGENT_ALT="prodction1"       # Intentional typo — matches existing data

# ── Paths (usually don't need to change) ────────────────────────────────────

ELKIE_HOME="/home/legs"                  # Base directory for ELKIE files
STAGING_DIR="${ELKIE_HOME}/sample_staging"
REPORTS_DIR="${ELKIE_HOME}/reports"
STATE_FILE="${ELKIE_HOME}/.sample_analyzer_state.json"
LOG_FILE="${ELKIE_HOME}/sample_analyzer.log"

REMNUX_INBOX="/home/${REMNUX_SSH_USER}/inbox"
REMNUX_RESULTS="/home/${REMNUX_SSH_USER}/results"
REMNUX_SCRIPT="/home/${REMNUX_SSH_USER}/analyze_sample.sh"
REMNUX_YARA_DIR="/home/${REMNUX_SSH_USER}/yara-rules"

# ── T-Pot Sample Directories ───────────────────────────────────────────────
# Comma-separated list of directories on T-Pot where honeypots store captures.

TPOT_SAMPLE_DIRS="/home/${TPOT_SSH_USER}/tpotce/data/cowrie/downloads,/home/${TPOT_SSH_USER}/tpotce/data/dionaea/binaries,/home/${TPOT_SSH_USER}/tpotce/data/honeytrap/downloads,/home/${TPOT_SSH_USER}/tpotce/data/adbhoney/downloads"

# ── Analysis Tuning ─────────────────────────────────────────────────────────

POLL_INTERVAL="60"                       # Seconds between ES poll cycles
SANDBOX_TIMEOUT="90"                     # Detonation duration in seconds
ANALYSIS_TIMEOUT="300"                   # Max static analysis wait (seconds)
MAX_SAMPLE_SIZE="52428800"               # 50MB max sample size
SAMPLE_RETENTION_DAYS="30"               # Days to keep analyzed samples
DEEP_ANALYSIS_THRESHOLD="40"             # Score threshold for Ghidra deep analysis
ALERT_CONFIDENCE_THRESHOLD="20"          # Min confidence to fire Discord alert
